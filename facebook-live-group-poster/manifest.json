{
  "manifest_version": 3,
  "name": "3SVerse Facebook Live Group Poster",
  "version": "1.0.0",
  "description": "Post a Facebook Live link with saved text and hashtags to selected joined groups.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "debugger"],
  "host_permissions": ["https://www.facebook.com/*", "https://m.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "3SVerse Facebook Live Group Poster",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
}
